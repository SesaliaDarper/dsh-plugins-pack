{
  "name": "dsh-task-notify",
  "version": "1.0.0",
  "private": false,
  "description": "任务完成通知 — DSH 每完成一轮对话，就在 Windows 右下角弹一条跟随当前主题（含子主题）的通知，带角色立绘",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "meta": {
    "title": "任务完成通知",
    "description": "每轮结束时在 Windows 右下角弹一条跟随当前主题的通知：卡片配色取 DSH 当前设计 token，角色取当前主题插件的立绘，逐像素 alpha 圆角，6.5 秒自动消失，最多堆叠 4 条。"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "notify",
    "notification",
    "toast",
    "windows"
  ],
  "author": "SesaliaDarper",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SesaliaDarper/dsh-plugins-pack.git",
    "directory": "packages/dsh-task-notify"
  },
  "homepage": "https://github.com/SesaliaDarper/dsh-plugins-pack/tree/main/packages/dsh-task-notify#readme",
  "bugs": {
    "url": "https://github.com/SesaliaDarper/dsh-plugins-pack/issues"
  }
}
